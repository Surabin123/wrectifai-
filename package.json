{
  "name": "wrectifai",
  "version": "0.0.0",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "api": "node -r dotenv/config -r @swc-node/register apps/api/src/main.ts",
    "web": "nx dev web",
    "mobile": "nx start mobile",
    "lint": "nx run-many -t lint --all",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "db:psql": "docker exec -it wrectifai_db psql -U postgres -d wrectifai",
    "db:test-up": "docker compose up -d test-postgres",
    "db:test-down": "docker compose stop test-postgres",
    "db:test-reset": "docker compose down test-postgres -v && docker compose up -d test-postgres",
    "db:test-psql": "docker exec -it wrectifai_test_db psql -U postgres -d wrectifai_test",
    "db:migrate": "node db/migrate.js",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "test:api": "nx test api",
    "test:api:unit": "nx test api unit",
    "test:web": "nx test web"
  },
  "private": true,
  "devDependencies": {
    "@eslint/compat": "^1.1.1",
